# Environnement de developpement : valeurs par defaut, rien a modifier.
# Port du site (Vite, rechargement a chaud)
WEB_PORT=5173
# Port de JupyterLab (sans jeton, usage local uniquement)
JUPYTER_PORT=8888
# Variante de PyTorch : cpu, ou cu124 pour un GPU NVIDIA (voir ./runDev.sh --gpu)
TORCH_INDEX=cpu
