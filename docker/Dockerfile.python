# Image Python de la formation : JupyterLab, bibliotheque ascent_agents, outils de construction.
# TORCH_INDEX choisit la variante de PyTorch : cpu (defaut) ou cu124 pour un GPU NVIDIA.
FROM python:3.12-slim
ARG TORCH_INDEX=cpu
ARG TORCH_VERSION=2.15.0
ENV PIP_NO_CACHE_DIR=1 PYTHONDONTWRITEBYTECODE=1 MPLBACKEND=Agg
WORKDIR /app
COPY docker/requirements.txt /tmp/requirements.txt
RUN pip install --index-url https://download.pytorch.org/whl/${TORCH_INDEX} torch==${TORCH_VERSION} \
 && pip install -r /tmp/requirements.txt
COPY python /app/python
RUN pip install -e /app/python
COPY tools /app/tools
COPY notebooks /app/notebooks
COPY docs /app/docs
EXPOSE 8888
CMD ["jupyter", "lab", "--ip=0.0.0.0", "--port=8888", "--no-browser", "--allow-root", "--ServerApp.token=", "--ServerApp.password=", "--notebook-dir=/app/notebooks"]
