# Site statique complet : donnees et notebooks generes par Python, site compile par Vite, servi par nginx.
ARG TORCH_INDEX=cpu
FROM python:3.12-slim AS donnees
ARG TORCH_INDEX
ARG TORCH_VERSION=2.15.0
ENV PIP_NO_CACHE_DIR=1 MPLBACKEND=Agg
WORKDIR /app
COPY docker/requirements.txt /tmp/requirements.txt
RUN pip install --index-url https://download.pytorch.org/whl/${TORCH_INDEX} torch==${TORCH_VERSION} \
 && pip install -r /tmp/requirements.txt
COPY python python
RUN pip install -e python
COPY tools tools
COPY notebooks notebooks
COPY docs docs
COPY web/public web/public
# Les notebooks sont livres deja executes : on regenere donnees, traces, rendus HTML et paquet Python.
RUN python tools/seed.py --sans-execution

FROM node:22-slim AS site
ARG VITE_DEPOT=martinobettucci/4-120
ARG VITE_BRANCHE=main
ENV VITE_DEPOT=${VITE_DEPOT} VITE_BRANCHE=${VITE_BRANCHE}
WORKDIR /app/web
COPY web/package.json web/package-lock.json ./
RUN npm ci --no-audit --no-fund
COPY web .
COPY docs /app/docs
COPY --from=donnees /app/web/public ./public
RUN npm run

FROM nginx:1.27-alpine
COPY docker/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=site /app/web/dist /usr/share/nginx/html
EXPOSE 80
